# Copy this file to `.streamlit/secrets.toml` (remove `.example`) and fill in
# your real values. NEVER commit the real secrets.toml.

[sendgrid]
# Create a free key: https://app.sendgrid.com -> Settings -> API Keys -> Create
api_key = "YOUR_SENDGRID_API_KEY"

# The verified sender address (must be verified in SendGrid),
# e.g. no-reply@vendinghealthyfuel.com
from_email = "no-reply@vendinghealthyfuel.com"

# Where enquiries are delivered:
to_email = "info@vendinghealthyfuel.com"
